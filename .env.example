# Exasol SaaS connection (get these from the SaaS console)
EXA_HOST=your-cluster-id.clusters.exasol.com
EXA_PORT=8563
EXA_USER=your_username
EXA_PASSWORD=your_personal_access_token
EXA_SCHEMA=LOGISENSE

# Backend auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Backend server
CORS_ORIGINS=http://localhost:5173

# Frontend (goes in frontend/.env.example)
VITE_API_URL=http://localhost:8000/api/v1